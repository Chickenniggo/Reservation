{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "Authors": ["Nicolai St\u00f6tzel"],
  "Cors": {
    "Origins": ["http://localhost:9090", "http://localhost:5080"]
  },
  "Database": {
    "Initialize": true
  },
  "Jwt": {
    "Audience": "account",
    "RequireHttpsMetadata": true
  },
  "Assets": {
    "TimeoutSeconds": 5
  }
}